<footer class="mt-16 border-t border-cream/15 py-10 text-center text-[0.88rem] leading-normal text-cream/65">
    <p class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-center gap-x-1.5 gap-y-1.5 px-2">
        <span class="inline-flex items-center gap-x-1.5">
            <span>Fait avec</span>
            <svg class="size-[1em] shrink-0 text-wine" viewBox="0 0 24 24" fill="currentColor" role="img" aria-label="amour" focusable="false">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>par Clémence</span>
        </span>
        <span>(et sous la supervision de Valentine, Sirius, et Nox)</span>
    </p>
    {% set showSecretD20Link = false %}
    {% if showSecretD20Link %}
        <p class="mt-3">
            <a href="{{ path('app_secret_d20') }}" class="text-xs uppercase tracking-[0.2em] text-cream/55 no-underline transition hover:text-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2">
                Surprise
            </a>
        </p>
    {% endif %}
</footer>
