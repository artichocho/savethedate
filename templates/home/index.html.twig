{% extends 'base.html.twig' %}

{% block title %}Clémence &amp; Valentine{% endblock %}
{% block meta_description %}Save the date - Clémence et Valentine se marient. Réservez la date de notre mariage.{% endblock %}

{% block body %}
    <article class="relative" aria-labelledby="page-title">
        <div class="relative overflow-hidden rounded-2xl border border-olive/40 bg-gradient-to-br from-forest/80 via-olive/35 to-forest/70 p-8 shadow-ethereal backdrop-blur-[2px] md:p-10">
            <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-olive/30 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-12 -left-10 h-40 w-40 rounded-full bg-forest/50 blur-3xl"></div>
            <div class="relative text-center">
                <h1 id="page-title" class="mb-6 text-4xl md:text-5xl">Save the date</h1>
                <p class="mx-auto mt-5 max-w-xl text-[0.95rem] font-light leading-relaxed text-cream/75">
                    Nous nous marions - les détails suivront bientôt. Merci de réserver cette journée ; une invitation complète vous parviendra ultérieurement.
                </p>

                <div class="my-10 flex items-center justify-center gap-4 text-gold/90">
                    <span class="h-px max-w-[6rem] flex-1 bg-gradient-to-r from-transparent via-cream/25 to-transparent"></span>
                    <svg class="h-8 w-8 shrink-0 opacity-90" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M12 2c-2 4-6 7-6 11a6 6 0 1012 0c0-4-4-7-6-11z" stroke="currentColor" stroke-width="1.1" fill="none"/>
                        <path d="M12 22V13" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                    </svg>
                    <span class="h-px max-w-[6rem] flex-1 bg-gradient-to-l from-transparent via-cream/25 to-transparent"></span>
                </div>

                <p class="text-sm font-light italic text-cream/70">Réservez la date -
                 le lieu et l’heure précise suivront.</p>
            </div>
        </div>
    </article>

    <section id="photos" class="relative mt-16 scroll-mt-28 md:mt-24" aria-labelledby="photos-heading">
        <h2 id="photos-heading" class="scroll-reveal mb-8 text-center text-3xl md:text-[2.25rem]">Quelques souvenirs</h2>
        <p class="scroll-reveal mx-auto mb-10 max-w-lg text-center text-sm font-light text-cream/60">
            Nos photos apparaîtront ici - glissez la page pour les découvrir petit à petit.
        </p>

        <div class="photo-grid mx-auto grid grid-cols-1 gap-6 sm:grid-cols-2">
            {% for i in 1..4 %}
                <figure class="scroll-reveal group relative aspect-[4/3] overflow-hidden rounded-2xl border border-olive/35 bg-gradient-to-br from-forest/70 via-green-deep/60 to-forest/80 shadow-soft">
                    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,rgb(96_108_56/0.25),transparent_55%)]"></div>
                    <div class="relative flex h-full w-full flex-col items-center justify-center gap-3 p-6 text-center">
                        <div class="rounded-full border border-dashed border-cream/25 bg-forest/40 p-4 text-cream/35 transition duration-500 group-hover:border-gold/30 group-hover:text-gold/50">
                            <svg class="h-12 w-12" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <rect x="6" y="10" width="36" height="28" rx="2" stroke="currentColor" stroke-width="1.2"/>
                                <circle cx="18" cy="22" r="3.5" stroke="currentColor" stroke-width="1"/>
                                <path d="M8 36l10-10 8 8 10-12 14 14" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <figcaption class="font-display text-lg text-cream/45">Photo {{ i }}</figcaption>
                        <span class="text-xs font-light text-cream/35">Emplacement réservé</span>
                    </div>
                </figure>
            {% endfor %}
        </div>
    </section>
{% endblock %}
