{# people — { role, is_temoin, name, phrase, image? } ; image = chemin logique AssetMapper, ex. images/trombi/prenom.jpg (fichier dans assets/images/…) #}
{% for person in people %}
    <div class="scroll-reveal flex h-full flex-col">
        <div class="flex h-full flex-col overflow-hidden rounded-2xl bg-forest/55 shadow-soft backdrop-blur-sm {% if person.is_temoin %}border-2 border-gold/90 ring-1 ring-gold/35{% else %}border border-olive/35{% endif %}">
            <div
                class="relative aspect-[4/5] w-full shrink-0 overflow-hidden bg-gradient-to-br from-forest/80 to-olive/20 {% if person.is_temoin %}border-b border-gold/25{% else %}border-b border-cream/10{% endif %}"
            >
                {% if person.image is defined and person.image %}
                    <img
                        src="{{ asset(person.image) }}"
                        alt="Portrait de {{ person.name|e }}"
                        class="absolute inset-0 h-full w-full object-cover object-center"
                        loading="lazy"
                        decoding="async"
                    >
                {% else %}
                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-4 text-center" role="img" aria-label="Photo de {{ person.name|e }} — à venir">
                        <svg class="h-12 w-12 text-cream/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
                            <path d="M12 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7z"/>
                            <path d="M4 20a8 8 0 0116 0" stroke-linecap="round"/>
                        </svg>
                        <span class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-cream/45">Photo</span>
                    </div>
                {% endif %}
            </div>
            <div class="flex flex-1 flex-col gap-2 p-5 pt-4">
                {# Hauteur mini. fixe pour que « Témoin » (1 ligne) et libellés longs (2–3 lignes) alignent les prénoms #}
                <p class="m-0 flex min-h-[3rem] items-start text-[0.65rem] font-semibold uppercase leading-snug tracking-[0.22em] {% if person.is_temoin %}text-gold/90{% else %}text-cream/50{% endif %}">{{ person.role }}</p>
                <p class="m-0 font-display text-xl text-cream">{{ person.name }}</p>
                <p class="m-0 flex-1 text-sm leading-relaxed text-cream/75">{{ person.phrase }}</p>
            </div>
        </div>
    </div>
{% endfor %}
