{% extends 'base.html.twig' %}

{% block title %}D20 Secret — Clémence &amp; Valentine{% endblock %}
{% block meta_description %}Page secrète pour lancer un D20.{% endblock %}

{% block body %}
    <section class="mx-auto max-w-xl text-center">
        <p class="mb-3 text-sm uppercase tracking-[0.22em] text-cream/60">Lancer de D20</p>
        <h1 class="mb-4 text-4xl md:text-[2.75rem]">Votre curiosité récompensée</h1>

        <div class="rounded-3xl border border-cream/15 bg-forest/55 px-6 py-10 shadow-[0_18px_45px_rgb(0_0_0/0.28)]">
            <div class="relative mb-8 flex justify-center" aria-hidden="true">
                <canvas id="d20-canvas" width="280" height="280" class="h-[220px] w-[220px] max-w-full"></canvas>
                <canvas id="d20-confetti-canvas" class="pointer-events-none absolute inset-0 h-full w-full"></canvas>
            </div>

            <p class="mb-2 text-xs uppercase tracking-[0.2em] text-cream/60">Resultat</p>
            <p id="d20-result" class="mb-8 text-[clamp(3rem,12vw,5rem)] leading-none text-gold" aria-live="polite">-</p>
            <button
                type="button"
                id="roll-d20-button"
                class="contact-action inline-flex items-center justify-center rounded-xl border border-cream/15 bg-forest/60 px-5 py-3 text-center text-sm font-semibold text-cream no-underline transition hover:border-gold/50 hover:bg-olive/35 disabled:cursor-not-allowed disabled:opacity-55"
            >
                Lancer le D20
            </button>
        </div>
    </section>

    <script>
        (() => {
            const button = document.getElementById('roll-d20-button');
            const result = document.getElementById('d20-result');
            const canvas = document.getElementById('d20-canvas');
            const confettiCanvas = document.getElementById('d20-confetti-canvas');
            let isRolling = false;
            let confettiFrameId = null;

            if (
                !(button instanceof HTMLButtonElement)
                || !(result instanceof HTMLElement)
                || !(canvas instanceof HTMLCanvasElement)
                || !(confettiCanvas instanceof HTMLCanvasElement)
            ) {
                return;
            }

            const context = canvas.getContext('2d');
            const confettiContext = confettiCanvas.getContext('2d');

            if (!context || !confettiContext) {
                return;
            }

            const resizeConfettiCanvas = () => {
                const pixelRatio = window.devicePixelRatio || 1;
                const width = canvas.clientWidth || canvas.width;
                const height = canvas.clientHeight || canvas.height;
                confettiCanvas.width = Math.floor(width * pixelRatio);
                confettiCanvas.height = Math.floor(height * pixelRatio);
                confettiContext.setTransform(1, 0, 0, 1, 0, 0);
                confettiContext.scale(pixelRatio, pixelRatio);
            };

            resizeConfettiCanvas();
            window.addEventListener('resize', resizeConfettiCanvas);

            const PHI = (1 + Math.sqrt(5)) / 2;
            const vertices = [
                [-1, PHI, 0], [1, PHI, 0], [-1, -PHI, 0], [1, -PHI, 0],
                [0, -1, PHI], [0, 1, PHI], [0, -1, -PHI], [0, 1, -PHI],
                [PHI, 0, -1], [PHI, 0, 1], [-PHI, 0, -1], [-PHI, 0, 1],
            ];

            const faces = [
                [0, 11, 5], [0, 5, 1], [0, 1, 7], [0, 7, 10], [0, 10, 11],
                [1, 5, 9], [5, 11, 4], [11, 10, 2], [10, 7, 6], [7, 1, 8],
                [3, 9, 4], [3, 4, 2], [3, 2, 6], [3, 6, 8], [3, 8, 9],
                [4, 9, 5], [2, 4, 11], [6, 2, 10], [8, 6, 7], [9, 8, 1],
            ];

            const normalize = (v) => {
                const len = Math.hypot(v[0], v[1], v[2]) || 1;
                return [v[0] / len, v[1] / len, v[2] / len];
            };

            const rotateVertex = (v, ax, ay, az) => {
                const [x0, y0, z0] = v;
                const cx = Math.cos(ax);
                const sx = Math.sin(ax);
                const cy = Math.cos(ay);
                const sy = Math.sin(ay);
                const cz = Math.cos(az);
                const sz = Math.sin(az);

                const y1 = y0 * cx - z0 * sx;
                const z1 = y0 * sx + z0 * cx;
                const x2 = x0 * cy + z1 * sy;
                const z2 = -x0 * sy + z1 * cy;
                const x3 = x2 * cz - y1 * sz;
                const y3 = x2 * sz + y1 * cz;

                return [x3, y3, z2];
            };

            const project = (v) => {
                const distance = 4.3;
                const scale = 152;
                const perspective = scale / (distance - v[2]);
                return {
                    x: v[0] * perspective + canvas.width / 2,
                    y: v[1] * perspective + canvas.height / 2,
                };
            };

            const drawDie = (ax, ay, az) => {
                context.clearRect(0, 0, canvas.width, canvas.height);
                context.save();
                context.translate(canvas.width / 2, canvas.height / 2);
                const aura = context.createRadialGradient(0, 8, 10, 0, 8, 120);
                aura.addColorStop(0, 'rgb(201 139 6 / 0.18)');
                aura.addColorStop(0.45, 'rgb(96 108 56 / 0.16)');
                aura.addColorStop(1, 'rgb(26 34 18 / 0)');
                context.fillStyle = aura;
                context.beginPath();
                context.arc(0, 8, 120, 0, Math.PI * 2);
                context.fill();
                context.restore();

                const rotated = vertices.map((v) => normalize(rotateVertex(v, ax, ay, az)));
                const light = normalize([0.25, -0.62, 1]);
                const resinHighlight = normalize([-0.35, -0.15, 1]);

                const prepared = faces
                    .map((face, index) => {
                        const a = rotated[face[0]];
                        const b = rotated[face[1]];
                        const c = rotated[face[2]];
                        const ab = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];
                        const ac = [c[0] - a[0], c[1] - a[1], c[2] - a[2]];
                        const normal = normalize([
                            ab[1] * ac[2] - ab[2] * ac[1],
                            ab[2] * ac[0] - ab[0] * ac[2],
                            ab[0] * ac[1] - ab[1] * ac[0],
                        ]);
                        const centerZ = (a[2] + b[2] + c[2]) / 3;
                        const brightness = Math.max(0.08, normal[0] * light[0] + normal[1] * light[1] + normal[2] * light[2]);
                        const highlight = Math.max(0, normal[0] * resinHighlight[0] + normal[1] * resinHighlight[1] + normal[2] * resinHighlight[2]);
                        const center = [
                            (a[0] + b[0] + c[0]) / 3,
                            (a[1] + b[1] + c[1]) / 3,
                            (a[2] + b[2] + c[2]) / 3,
                        ];
                        return { face, centerZ, brightness, highlight, center, index };
                    })
                    .sort((f1, f2) => f1.centerZ - f2.centerZ);

                for (const item of prepared) {
                    const p0 = project(rotated[item.face[0]]);
                    const p1 = project(rotated[item.face[1]]);
                    const p2 = project(rotated[item.face[2]]);

                    const resinDepth = Math.round(18 + item.brightness * 24);
                    const green = Math.min(82, resinDepth + 30);
                    const blue = Math.min(52, resinDepth + 12);
                    const alpha = 0.62 + item.brightness * 0.2;

                    context.fillStyle = `rgb(${resinDepth} ${green} ${blue} / ${alpha})`;
                    context.strokeStyle = 'rgb(254 250 224 / 0.38)';
                    context.lineWidth = 1;
                    context.beginPath();
                    context.moveTo(p0.x, p0.y);
                    context.lineTo(p1.x, p1.y);
                    context.lineTo(p2.x, p2.y);
                    context.closePath();
                    context.fill();
                    context.stroke();

                    if (item.highlight > 0.3) {
                        const gloss = Math.min(0.26, (item.highlight - 0.3) * 0.52);
                        context.fillStyle = `rgb(254 250 224 / ${gloss})`;
                        context.fill();
                    }
                }

                context.globalCompositeOperation = 'screen';
                const sparkle = context.createRadialGradient(118, 94, 6, 118, 94, 72);
                sparkle.addColorStop(0, 'rgb(254 250 224 / 0.28)');
                sparkle.addColorStop(0.55, 'rgb(201 139 6 / 0.12)');
                sparkle.addColorStop(1, 'rgb(201 139 6 / 0)');
                context.fillStyle = sparkle;
                context.beginPath();
                context.arc(118, 94, 72, 0, Math.PI * 2);
                context.fill();
                context.globalCompositeOperation = 'source-over';
            };

            const launchConfetti = () => {
                if (confettiFrameId !== null) {
                    window.cancelAnimationFrame(confettiFrameId);
                    confettiFrameId = null;
                }

                resizeConfettiCanvas();
                const width = canvas.clientWidth || canvas.width;
                const height = canvas.clientHeight || canvas.height;
                const originX = width / 2;
                const originY = height * 0.34;
                const colors = ['#fefae0', '#c98b06', '#606c38', '#d6a940', '#e8edd8'];
                const pieces = Array.from({ length: 75 }, () => {
                    const angle = (Math.random() * Math.PI) + (Math.PI * 0.05);
                    const speed = 1.4 + Math.random() * 2.8;
                    return {
                        x: originX,
                        y: originY,
                        vx: Math.cos(angle) * speed,
                        vy: -Math.sin(angle) * speed,
                        rotation: Math.random() * Math.PI * 2,
                        rotationSpeed: (Math.random() - 0.5) * 0.12,
                        size: 4 + Math.random() * 5,
                        color: colors[Math.floor(Math.random() * colors.length)],
                        life: 1,
                        driftSeed: Math.random() * Math.PI * 2,
                    };
                });

                const gravity = 0.065;
                const drag = 0.992;
                const fade = 0.0075;
                let lastTimestamp = null;

                const animateConfetti = (now) => {
                    const deltaMs = lastTimestamp === null ? 16 : Math.min(32, now - lastTimestamp);
                    const deltaFactor = deltaMs / 16.6667;
                    lastTimestamp = now;
                    confettiContext.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
                    let hasVisiblePiece = false;

                    for (const piece of pieces) {
                        const lateralDrift = Math.sin((now * 0.0026) + piece.driftSeed) * 0.018;
                        piece.vx = (piece.vx + lateralDrift) * (drag ** deltaFactor);
                        piece.vy = (piece.vy * (drag ** deltaFactor)) + (gravity * deltaFactor);
                        piece.x += piece.vx * deltaFactor;
                        piece.y += piece.vy * deltaFactor;
                        piece.rotation += piece.rotationSpeed * deltaFactor;
                        piece.life -= fade * deltaFactor;

                        if (piece.life <= 0) {
                            continue;
                        }

                        hasVisiblePiece = true;
                        confettiContext.save();
                        confettiContext.translate(piece.x, piece.y);
                        confettiContext.rotate(piece.rotation);
                        confettiContext.globalAlpha = Math.max(0, piece.life);
                        confettiContext.fillStyle = piece.color;
                        confettiContext.fillRect(-piece.size / 2, -piece.size / 2, piece.size, piece.size * 0.62);
                        confettiContext.restore();
                    }

                    if (hasVisiblePiece) {
                        confettiFrameId = window.requestAnimationFrame(animateConfetti);
                        return;
                    }

                    confettiContext.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
                    confettiFrameId = null;
                };

                confettiFrameId = window.requestAnimationFrame(animateConfetti);
            };

            let baseX = 0.72;
            let baseY = 0.58;
            let baseZ = 0.1;
            drawDie(baseX, baseY, baseZ);

            button.addEventListener('click', () => {
                if (isRolling) {
                    return;
                }

                isRolling = true;
                button.disabled = true;
                const value = Math.floor(Math.random() * 20) + 1;
                result.textContent = '...';

                const durationMs = 1250;
                const start = performance.now();
                const spinX = (Math.random() * 6 + 8) * Math.PI;
                const spinY = (Math.random() * 6 + 8) * Math.PI;
                const spinZ = (Math.random() * 2 + 2) * Math.PI;

                const animate = (now) => {
                    const t = Math.min(1, (now - start) / durationMs);
                    const easeOut = 1 - (1 - t) ** 3;
                    drawDie(
                        baseX + spinX * easeOut,
                        baseY + spinY * easeOut,
                        baseZ + spinZ * easeOut
                    );

                    if (t < 1) {
                        window.requestAnimationFrame(animate);
                        return;
                    }

                    baseX += spinX;
                    baseY += spinY;
                    baseZ += spinZ;
                    drawDie(baseX, baseY, baseZ);
                    result.textContent = String(value);
                    if (value === 20) {
                        launchConfetti();
                    }
                    button.disabled = false;
                    isRolling = false;
                };

                window.requestAnimationFrame(animate);
            });
        })();
    </script>
{% endblock %}
